# Seeds 1 and 2 of the main configuration (seed 0 is td3_ppo in td3.plan): H1 needs mean and CI over seeds.
# Local environments only (2 x (24 + 8) = 64 CPUs): no worker jobs to choreograph.
td3_ppo_s1 ft.seed=1 ft.n_envs=24 ft.remote_envs=0 ft.val_workers=8 ft.td3=True ft.actor_delay=2 ft.q_norm=True ft.n_step=3 ft.bc_policy_weight=0.5 ft.bc_weight=0.5 ft.lr_actor=3e-5 ft.warmup_steps=100000 ft.utd=0.5 ft.td3_explore_std=0.03 ft.td3_explore_final=0.01 ft.td3_target_noise=0.06 ft.td3_noise_clip=0.15 env.post_success=True ft.bc_checkpoint=/orcd/scratch/orcd/012/conchell/td3_share/ppo_b1300 ft.demos=[/orcd/scratch/orcd/012/conchell/td3_share/rl_demos_ps/part0.npz,/orcd/scratch/orcd/012/conchell/td3_share/rl_demos_ps/part1.npz,/orcd/scratch/orcd/012/conchell/td3_share/rl_demos_ps/part2.npz,/orcd/scratch/orcd/012/conchell/td3_share/rl_demos_ps/part3.npz,/orcd/scratch/orcd/012/conchell/td3_share/rl_demos_ps/part4.npz,/orcd/scratch/orcd/012/conchell/td3_share/rl_demos_ps/part5.npz]
td3_ppo_s2 ft.seed=2 ft.n_envs=24 ft.remote_envs=0 ft.val_workers=8 ft.td3=True ft.actor_delay=2 ft.q_norm=True ft.n_step=3 ft.bc_policy_weight=0.5 ft.bc_weight=0.5 ft.lr_actor=3e-5 ft.warmup_steps=100000 ft.utd=0.5 ft.td3_explore_std=0.03 ft.td3_explore_final=0.01 ft.td3_target_noise=0.06 ft.td3_noise_clip=0.15 env.post_success=True ft.bc_checkpoint=/orcd/scratch/orcd/012/conchell/td3_share/ppo_b1300 ft.demos=[/orcd/scratch/orcd/012/conchell/td3_share/rl_demos_ps/part0.npz,/orcd/scratch/orcd/012/conchell/td3_share/rl_demos_ps/part1.npz,/orcd/scratch/orcd/012/conchell/td3_share/rl_demos_ps/part2.npz,/orcd/scratch/orcd/012/conchell/td3_share/rl_demos_ps/part3.npz,/orcd/scratch/orcd/012/conchell/td3_share/rl_demos_ps/part4.npz,/orcd/scratch/orcd/012/conchell/td3_share/rl_demos_ps/part5.npz]
