# TD3+BC fine-tuning plans for scripts/orcd/ft.sbatch (one run per line: RUN_NAME KEY=VALUE ...; see docs/td3.md).
# Starting policy: PPO b=1300; demonstrations: 6,000 (C) episodes (~760k transitions) made with env.post_success=true,
# so the training environment runs post-success too (episodes graded to the scene's end, as the harness does).
# Two runs = 2 x (16 local envs + 8 validation workers) = 48 CPUs: submit with -c 50; remote envs: env_workers.sbatch.
td3_ppo ft.td3=True ft.actor_delay=2 ft.q_norm=True ft.n_step=3 ft.bc_policy_weight=0.5 ft.bc_weight=0.5 ft.lr_actor=3e-5 ft.warmup_steps=100000 ft.utd=0.5 ft.td3_explore_std=0.03 ft.td3_explore_final=0.01 ft.td3_target_noise=0.06 ft.td3_noise_clip=0.15 ft.n_envs=16 ft.remote_envs=48 ft.val_workers=8 env.post_success=True ft.bc_checkpoint=/orcd/scratch/orcd/012/conchell/td3_share/ppo_b1300 ft.demos=[/orcd/scratch/orcd/012/conchell/td3_share/rl_demos_ps/part0.npz,/orcd/scratch/orcd/012/conchell/td3_share/rl_demos_ps/part1.npz,/orcd/scratch/orcd/012/conchell/td3_share/rl_demos_ps/part2.npz,/orcd/scratch/orcd/012/conchell/td3_share/rl_demos_ps/part3.npz,/orcd/scratch/orcd/012/conchell/td3_share/rl_demos_ps/part4.npz,/orcd/scratch/orcd/012/conchell/td3_share/rl_demos_ps/part5.npz]
td3_ppo_anchor0 ft.td3=True ft.actor_delay=2 ft.q_norm=True ft.n_step=3 ft.bc_policy_weight=0.0 ft.bc_weight=0.5 ft.lr_actor=3e-5 ft.warmup_steps=100000 ft.utd=0.5 ft.td3_explore_std=0.03 ft.td3_explore_final=0.01 ft.td3_target_noise=0.06 ft.td3_noise_clip=0.15 ft.n_envs=16 ft.remote_envs=48 ft.val_workers=8 env.post_success=True ft.bc_checkpoint=/orcd/scratch/orcd/012/conchell/td3_share/ppo_b1300 ft.demos=[/orcd/scratch/orcd/012/conchell/td3_share/rl_demos_ps/part0.npz,/orcd/scratch/orcd/012/conchell/td3_share/rl_demos_ps/part1.npz,/orcd/scratch/orcd/012/conchell/td3_share/rl_demos_ps/part2.npz,/orcd/scratch/orcd/012/conchell/td3_share/rl_demos_ps/part3.npz,/orcd/scratch/orcd/012/conchell/td3_share/rl_demos_ps/part4.npz,/orcd/scratch/orcd/012/conchell/td3_share/rl_demos_ps/part5.npz]
